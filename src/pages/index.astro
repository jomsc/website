---
import '../styles/global.css';
import { Image } from 'astro:assets';
import image_1 from "../assets/joseph.jpg";
import image_2 from "../assets/projets.jpg";
import image_3 from "../assets/links.png";
import video_simon from "../assets/simon.mp4"
import GlitchLoader from '../components/GlitchLoader.astro';
import TopoBackground from '../components/TopoBackground.astro';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="generator" content={Astro.generator} >
  <title>JOMSC</title>
</head>
<body class="h-full grid">
  <TopoBackground />
  <GlitchLoader />

  <div id="main-layout" class="flex w-full h-full col-start-1 row-start-1 z-30">

    <!-- Video Section -->
    <div id="video-col" class="relative overflow-hidden">
      <div class="absolute inset-0 menuvideo">
        <video class="w-full h-full object-cover object-center menuvideo" autoplay muted loop playsinline>
          <source src={video_simon} type="video/mp4">
          WHERE IS THE VIDEO
        </video>
      </div>
      <h1 class="titre relative z-40 tracking-[-.02em] p-8 mix-blend-difference">JOSEPH MOUSCADET</h1>
    </div>

    <!-- Buttons -->
    <div id="buttons-group" class="flex buttons-group relative z-30">
      <a id="btn-0" class="btn-item corps" data-original-text="WHO AM I ?"       data-duration="500" data-link="whoami"   data-imageid=".image1" href="/whoami/"><h2>WHO AM I ?</h2></a>
      <a id="btn-1" class="btn-item corps" data-original-text="PROJECTS"         data-duration="500" data-link="projects" data-imageid=".image2" href="/projects/"><h2>PROJECTS</h2></a>
      <a id="btn-3" class="btn-item corps" data-original-text="LINKS / CONTACT"  data-duration="500" data-link="contact"  data-imageid=".image3" href="/contact/"><h2>LINKS / CONTACT</h2></a>
    </div>
  </div>

  <!-- Background Images — z-40: above buttons (z-30) but below clone (z-50) -->
  <div class="col-start-1 row-start-1 z-40 w-screen h-screen flex items-center justify-center pointer-events-none">
    <Image src={image_1} alt="Me!!!" class="w-1/2 object-cover image-menu opacity-0 image1" />
  </div>
  <div class="col-start-1 row-start-1 z-40 w-screen h-screen flex items-center justify-center pointer-events-none">
    <Image src={image_2} alt="Projects" class="w-1/3 object-cover image-menu opacity-0 image2" />
  </div>
  <div class="col-start-1 row-start-1 z-40 w-screen h-screen flex items-center justify-center pointer-events-none">
    <Image src={image_3} alt="Links" class="w-1/3 object-cover image-menu opacity-0 image3" />
  </div>
</body>
</html>

<style>
  .menuvideo,
  .btn-item,
  .image-menu {
    transition: opacity 0.3s ease;
  }

  /* ── Mobile layout ── */
  #main-layout {
    flex-direction: column;
    overflow: hidden;
    height: 100vh;        /* fallback for old browsers */
    height: 100dvh;       /* excludes Safari's address/nav bars */
  }

  #video-col {
    width: 100vw;
    /* fill all remaining height above the buttons row */
    flex: 1 1 0;
    min-height: 0;
    /* crop sides so video fills height fully */
    overflow: hidden;
  }

  #buttons-group {
    width: 100vw;
    flex-direction: row;
    flex-shrink: 0;
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: none;
  }
  #buttons-group::-webkit-scrollbar { display: none; }

  .btn-item {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-start;
    text-decoration: none;
    white-space: nowrap;
    /* no background-color transition on mobile so tap feedback is instant */
    transition: opacity 0.3s ease;
    /* smaller border + text on mobile; extend bottom by the safe-area
       inset so buttons fill to the edge above Safari's home indicator */
    border-width: 0px 0px 1px 1px;
    padding: 0.4rem 0.7rem;
    padding-bottom: calc(0.4rem + env(safe-area-inset-bottom));
  }

  /* Darker grey to acknowledge a tap on mobile */
  .btn-item:active {
    background-color: #a9a9a9;
  }

  .btn-item h2 {
    font-size: 1.6rem;
    font-family: DataControl, sans-serif;
  }

  /* ── Desktop overrides ── */
  @media (min-width: 768px) {
    #main-layout {
      flex-direction: row;
      overflow: visible;
    }
    #video-col {
      width: 50%;
      height: 100vh;
      flex-shrink: 0;
    }
    #buttons-group {
      width: 50%;
      height: 100vh;
      flex-direction: column;
      overflow: visible;
    }
    .btn-item {
      /* Every button gets the same fixed share of the column height
         (3 buttons = one third each). Nothing resizes on hover anymore. */
      flex: 1 1 0;
      min-height: 0;
      white-space: normal;
      align-items: flex-start;
      width: 100%;
      padding: 1rem 2rem;
      border-width: 0px 0px 1px 1px;
      transition: opacity 0.3s ease, background-color 0.2s ease;
    }
    .btn-item h2 {
      font-size: 3rem;
    }
  }
</style>

<script>
  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()-_[]{}+=?';
  const randChar = () => CHARS[Math.floor(Math.random() * CHARS.length)];

  // ⚙️ Idle timeout: milliseconds without mouse movement before the hover exits
  const IDLE_TIMEOUT_MS = 2000;

  // One AbortController per init, so re-running init (DOMContentLoaded +
  // astro:page-load) never stacks duplicate listeners.
  let controller: AbortController | null = null;

  function init() {
    const group    = document.getElementById('buttons-group');
    const videocol = document.getElementById('video-col');
    if (!group || !videocol) return;

    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    // Mobile: no hover/glitch wiring. Buttons just navigate;
    // CSS .btn-item:active gives tap feedback.
    const isDesktop = window.matchMedia('(min-width: 768px) and (pointer: fine)').matches;
    if (!isDesktop) return;

    const buttons = Array.from(group.querySelectorAll<HTMLElement>('.btn-item'));

    let activeBtn: HTMLElement | null = null;
    let idleTimer: ReturnType<typeof setTimeout> | null = null;
    let scrambleId: number | null = null;
    let clone: HTMLElement | null = null;

    // ── visuals ──────────────────────────────────────────────────────────
    function setImage(btn: HTMLElement, visible: boolean) {
      const sel = btn.dataset.imageid;
      if (!sel) return;
      document.querySelectorAll<HTMLElement>(sel).forEach(el => {
        el.style.opacity = visible ? '1' : '0';
      });
    }

    // Global "hover mode": buttons + video fade out, title turns black.
    function setHoverMode(on: boolean) {
      buttons.forEach(b => {
        b.style.opacity = on ? '0' : '1';
        if (!on) b.style.backgroundColor = '';
      });
      videocol!.querySelectorAll<HTMLElement>('.menuvideo').forEach(el => {
        el.style.opacity = on ? '0' : '1';
      });
      document.querySelectorAll<HTMLElement>('.titre').forEach(el => {
        el.style.color = on ? '#000000' : '#ffffff';
      });
    }

    // ── floating scrambled text ──────────────────────────────────────────
    // Buttons no longer resize, so the clone is placed once (and again on
    // window resize) instead of being chased every frame.
    function placeClone() {
      if (!activeBtn || !clone) return;
      const h2 = activeBtn.querySelector('h2') as HTMLElement;
      const r = h2.getBoundingClientRect();
      clone.style.left = r.left + 'px';
      clone.style.top  = r.top  + 'px';
    }

    function stopTextAnim() {
      if (scrambleId) { cancelAnimationFrame(scrambleId); scrambleId = null; }
      document.querySelectorAll('.text-clone').forEach(el => el.remove());
      clone = null;
      buttons.forEach(b => {
        const h2 = b.querySelector('h2') as HTMLElement | null;
        if (h2) h2.style.opacity = '1';
      });
    }

    function startTextAnim(btn: HTMLElement) {
      stopTextAnim();
      const h2 = btn.querySelector('h2') as HTMLElement;
      const original = btn.dataset.originalText || h2.textContent || '';
      const duration = parseInt(btn.dataset.duration || '500');
      h2.style.opacity = '0';

      // Copy the real heading's type metrics so the clone sits exactly on it.
      const cs = getComputedStyle(h2);
      clone = document.createElement('h2');
      clone.className = 'floating-text text-clone pointer-events-none mix-blend-difference';
      Object.assign(clone.style, {
        position:        'fixed',
        zIndex:          '50',
        margin:          '0',
        color:           '#00ff00',
        backgroundColor: '#002a66',
        pointerEvents:   'none',
        fontSize:        cs.fontSize,
        lineHeight:      cs.lineHeight,
        letterSpacing:   cs.letterSpacing,
      });
      document.body.appendChild(clone);
      placeClone();

      const start = performance.now();
      const step = (now: number) => {
        if (!clone) return;
        const progress = Math.min((now - start) / duration, 1);
        const keepUpTo = Math.ceil(original.length * progress);
        clone.textContent =
          original.slice(0, keepUpTo) +
          original.slice(keepUpTo).split('')
            .map(c => (c === ' ' || c === '/') ? c : randChar()).join('');
        scrambleId = progress < 1 ? requestAnimationFrame(step) : null;
      };
      scrambleId = requestAnimationFrame(step);
    }

    // ── idle timer ───────────────────────────────────────────────────────
    function clearIdle() {
      if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
    }
    function resetIdle() {
      clearIdle();
      if (activeBtn) idleTimer = setTimeout(release, IDLE_TIMEOUT_MS);
    }

    // ── hover state ──────────────────────────────────────────────────────
    // Hovering a button always switches to it, even if another one is active.
    function activate(btn: HTMLElement) {
      if (activeBtn === btn) { resetIdle(); return; }
      const prev = activeBtn;
      if (prev) setImage(prev, false);   // cross-fades with the next image
      activeBtn = btn;
      setImage(btn, true);
      if (!prev) setHoverMode(true);
      startTextAnim(btn);
      resetIdle();
    }

    function release() {
      if (!activeBtn) return;
      clearIdle();
      setImage(activeBtn, false);
      activeBtn = null;
      setHoverMode(false);
      stopTextAnim();
    }

    buttons.forEach(btn => {
      btn.addEventListener('mouseenter', () => activate(btn), { signal });
    });

    // Crossing into the left (video) side releases the active button.
    videocol.addEventListener('mouseenter', release, { signal });

    // Any movement keeps the hover alive; 2s of stillness releases it.
    document.addEventListener('mousemove', () => { if (activeBtn) resetIdle(); }, { signal });
    window.addEventListener('resize', placeClone, { signal });
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load',  init);
</script>